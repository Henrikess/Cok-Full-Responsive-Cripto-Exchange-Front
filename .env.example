# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Authentication (simple manual auth)
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-in-production
AUTH_SECRET=generate-a-random-secret-here-min-32-chars

# Mercado Bitcoin API
MB_API_KEY=your-mb-api-key
MB_API_SECRET=your-mb-api-secret
MB_API_BASE_URL=https://api.mercadobitcoin.net/api/v4

# Cache settings (in seconds)
CACHE_BALANCES_TTL=30
CACHE_ORDERS_TTL=20
